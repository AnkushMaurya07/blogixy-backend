# =============================================================================
# Blogixy Backend — environment reference
# =============================================================================
# How to use:
#   LOCAL       → copy `backend/.env.local` to `backend/.env`  (or use values below)
#   PRODUCTION  → set the PRODUCTION block on your host (Render, Railway, etc.)
#
# Comma-separated lists: no spaces after commas unless the value itself needs them.
# URLs in CORS/CSRF must include scheme (http/https) and must NOT end with /
# ALLOWED_HOSTS: hostname only, no scheme, no trailing slash
# =============================================================================


# =============================================================================
# LOCAL (development) — active defaults in backend/.env.local
# =============================================================================

SECRET_KEY=local-dev-secret-change-before-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:3000,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:3000,http://localhost:3000


# =============================================================================
# PRODUCTION (deploy) — copy these values to your hosting dashboard
# =============================================================================
# Replace every placeholder with your real URLs before going live.
#
# SECRET_KEY=<run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">
# DEBUG=False
# ALLOWED_HOSTS=your-api.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
#
# After frontend is deployed, put its exact URL in CORS_ALLOWED_ORIGINS and
# CSRF_TRUSTED_ORIGINS (both must match, including https).
